# Cold Storage deployment configuration.
#
# Copy to .env and edit, or just run ./deploy.sh which writes one for you.
# .env is gitignored — it holds your secret key.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Generate with:  python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
# With DJANGO_DEBUG=0 the container refuses to start without this.
DJANGO_SECRET_KEY=

# The public hostname the reverse proxy serves, comma-separated.
#
# Keep localhost and 127.0.0.1 in the list: the container's healthcheck probes
# http://localhost:8000/healthz/ from inside the container, and Django answers
# 400 DisallowedHost for any Host header not listed here.
DJANGO_ALLOWED_HOSTS=coldstorage.example.com,localhost,127.0.0.1

# Public origins allowed to POST. Django requires the scheme, and it must be
# the *public* one (https://), not the http:// the proxy speaks internally —
# otherwise every form and API write fails CSRF validation.
DJANGO_CSRF_TRUSTED_ORIGINS=https://coldstorage.example.com

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------

# The Docker network your proxy container already runs on. The app publishes
# no host port; the proxy reaches it at http://coldstorage:8000 on this
# network. deploy.sh detects this from the running proxy container.
PROXY_NETWORK=caddy

# true  = join a network that already exists (the normal case).
# false = let compose create and manage it; you then attach your proxy to it.
PROXY_NETWORK_EXTERNAL=true

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Container and hostname on the proxy network. Change it if `coldstorage` is
# already taken; the Caddyfile must match.
COMPOSE_SERVICE_NAME=coldstorage

# Never set this to 1 on a deployment. Debug off is what enables HSTS, the
# HTTPS redirect and secure session/CSRF cookies.
DJANGO_DEBUG=0

# Gunicorn worker processes. A sensible starting point is (2 x CPUs) + 1.
WEB_CONCURRENCY=3

DJANGO_LOG_LEVEL=INFO

# SQLite on a named volume — one container, no database service to run.
# For PostgreSQL, set DJANGO_DB_ENGINE=postgresql and the rest; psycopg is
# already in the image. The database itself is then yours to run elsewhere,
# since this stack is deliberately a single container.
DJANGO_DB_ENGINE=sqlite3
DJANGO_DB_NAME=/app/data/db.sqlite3
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=
# DJANGO_DB_PORT=

# Only used with docker-compose.hostport.yml (proxy running on the host, not
# in a container). 127.0.0.1 keeps the plain-HTTP app off every other
# interface.
# PUBLISH_BIND=127.0.0.1
# PUBLISH_PORT=8000
